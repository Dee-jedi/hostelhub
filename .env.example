# Copy to .env.local and fill in. Never commit the real values.

# Paystack (test keys while demoing; the hostel's live keys at handover)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Firebase web config (Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin: a local file path, or (on Vercel) the JSON file base64-encoded
FIREBASE_SERVICE_ACCOUNT_PATH=hostelhub_service_account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Signs the QR code on tenant ID cards (any long random string)
ID_CARD_SECRET=

# Multi-hostel addressing. Hostels live on subdomains of the platform domain (unset until the
# domain is bought); other addresses (localhost, *.hosted.app) serve the default hostel.
# Locally, mowarid.localhost:3000 also works as a subdomain.
# NEXT_PUBLIC_PLATFORM_DOMAIN=hostelhub.africa
NEXT_PUBLIC_DEFAULT_HOSTEL=mowarid

# Which Firestore database to use: "(default)" for live, "staging" for the staging database
# NEXT_PUBLIC_FIRESTORE_DATABASE=staging
