rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Passport photos: each tenant uploads only into their own folder, images under 2 MB.
    // (The app resizes photos in the browser first, so real uploads are ~100 KB.)
    match /passports/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Photos attached to repair requests and complaints, same limits
    match /requests/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
